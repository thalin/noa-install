# GPT layout with a BIOS-boot partition for grub, matching target-vm's plain
# SeaBIOS (non-UEFI) boot mode. Adapted from disko's single-disk example.
{
  disko.devices = {
    disk = {
      main = {
        device = "/dev/vda";
        type = "disk";
        content = {
          type = "gpt";
          partitions = {
            boot = {
              size = "1M";
              type = "EF02"; # BIOS boot partition, required for grub on GPT
            };
            root = {
              size = "100%";
              content = {
                type = "filesystem";
                format = "ext4";
                mountpoint = "/";
              };
            };
          };
        };
      };
    };
  };
}
